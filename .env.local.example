# --- Sanity project ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Viewer/read token created at sanity.io/manage -> API -> Tokens (Viewer role)
SANITY_API_READ_TOKEN=sk_your_read_token

# Shared secret for /api/draft and /api/revalidate
SANITY_REVALIDATE_SECRET=choose_a_long_random_string
# Same value, exposed to the Studio so the Deploy Vibe action can call the endpoint
NEXT_PUBLIC_SANITY_REVALIDATE_SECRET=choose_a_long_random_string

# Absolute site URL used by the Presentation tool and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
